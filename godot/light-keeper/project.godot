; Engine configuration file.
; Path of the Light Keeper: Godot prototype of the Farluck Farm seed shed battle.

config_version=5

[application]

config/name="Path of the Light Keeper"
config/description="Farluck Farm seed shed hex battle (Godot prototype)"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/bg_color=Color(0.08, 0.06, 0.05, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.08, 0.06, 0.05, 1)
